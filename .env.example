# Copy this file to .env.local and fill in the values.

# NextAuth configuration
# NEXTAUTH_URL is the canonical URL of your deployment (use http://localhost:3000 locally).
NEXTAUTH_URL=http://localhost:3000
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# GitHub OAuth application
# Create an OAuth App: https://github.com/settings/applications/new
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# The OAuth app needs the `repo` and `user:email` scopes to read repo traffic.
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Optional server-only token for public repository analysis.
# Strongly recommended for public deployments so the analyzer does not rely on
# GitHub's unauthenticated 60 requests/hour quota. Use a read-only fine-grained
# token and never expose it to browser/client code.
GITHUB_PUBLIC_TOKEN=your-read-only-github-token

# Anthropic API key for the "Summarize my traffic" AI insights panel (/api/insights).
# Get one at https://console.anthropic.com/. Optional — the insights panel is
# disabled gracefully when this is unset.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Set to true in the application Worker only after configuring the snapshot
# Worker's RESEND_API_KEY and REPORT_FROM_EMAIL secrets on a verified sender domain.
# The settings UI stays disabled until delivery is ready.
DIGEST_EMAIL_ENABLED=false

# Let `next build` succeed in CI without real OAuth/Anthropic credentials.
# SKIP_ENV_VALIDATION=true
