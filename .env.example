# Copy this file to .env.local and fill in the values.

# NextAuth configuration
# NEXTAUTH_URL is the canonical URL of your deployment (use http://localhost:3000 locally).
NEXTAUTH_URL=http://localhost:3000
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# GitHub OAuth application
# Create an OAuth App: https://github.com/settings/applications/new
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# The OAuth app needs the `repo` and `user:email` scopes to read repo traffic.
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Anthropic API key for the "Summarize my traffic" AI insights panel (/api/insights).
# Get one at https://console.anthropic.com/. Optional — the insights panel is
# disabled gracefully when this is unset.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Let `next build` succeed in CI without real OAuth/Anthropic credentials.
# SKIP_ENV_VALIDATION=1
